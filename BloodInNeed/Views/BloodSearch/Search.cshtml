@{
    ViewBag.Title = "Blood Search";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="container">
    <div class="search"> 
        <div class="row"> 
            <div class="col-md-6"> 
                <div class="search-1"> 
                    <i class='bx bx-search-alt'></i> 
                    <input type="text" id="bloodGroupSearch" list="bloodGroupsData" placeholder="Blood Group">
                    <datalist id="bloodGroupsData">


                    </datalist>
                </div> 
             </div>
             <div class="col-md-6"> 
                 <div> 
                     <div class="search-2">
                        <i class="fa fa-map-marker" style="color:red"></i>
                        <input type="text" id="citySearch" list="citySearchData" placeholder="City/Town">
                        <datalist id="citySearchData">
                         
                        </datalist>
                         <button>Search</button> 
                     </div>
                 </div> 
             </div> 
        </div>
     </div>
</div>



<script src="~/js/BloodSearch.js"></script>