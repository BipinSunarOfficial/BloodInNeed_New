
@model BloodInNeed.UI.Models.ViewModels.HomePageViewModel
@using Microsoft.Extensions.Options
@inject IOptions<BloodInNeed.UI.Models.ApplicationSettings> AppSettings
@{
    ViewData["Title"] = "Home";
}

@* <script src="https://cdnjs.cloudflare.com/ajax/libs/countup.js/2.0.7/countUp.min.js"></script> *@


<!-- Main Hero Section -->
<div class="container text-center py-5">
    <h1 class="display-4 fw-bold" style="color:#b30808e6;">@AppSettings.Value.Name</h1>
    <p class="lead text-muted">Connecting lives through the power of donation.</p>
</div>

<!-- Key Statistics Cards -->
<div class="container mb-5">
    <h2 class="text-center mb-4">Platform Highlights</h2>
    <div class="row g-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100 text-center">
                <div class="card-body">
                    <i class="fa fa-user-plus fa-2x mb-3 text-danger"></i>
                    <h3 class="card-title" id="registeredDonors">@ViewBag.RegisteredDonors</h3>
                    <p class="card-text">Registered Donors</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100 text-center">
                <div class="card-body">
                    <i class="fas fa-hand-holding-medical fa-2x mb-3 text-primary"></i>
                    <h3 class="card-title" id="requestsFulfilled">@ViewBag.BloodRequestsFulfilled</h3>
                    <p class="card-text">Blood Requests Fulfilled</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100 text-center">
                <div class="card-body">
                    <i class="fas fa-users fa-2x mb-3 text-success"></i>
                    <h3 class="card-title" id="activeDonors">@ViewBag.ActiveDonors</h3>
                    <p class="card-text">Active Donors</p>
                </div>
            </div>
        </div>
    </div>
</div>

