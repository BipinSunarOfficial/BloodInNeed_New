<!-- Statistics by Country -->
<div class="container mb-5">
    <h2 class="text-center mb-4">Statistics by Country</h2>
    <div class="table-responsive">
        <table class="table table-bordered text-center align-middle shadow-sm">
            <thead class="table-light">
                <tr>
                    <th>Country</th>
                    <th>Total Users</th>
                    <th>Total Donors</th>
                    <th>Requests Fulfilled</th>
                </tr>
            </thead>
            <tbody>
                @{
                    var countries = new[]
                    {
                        new { Flag = "np", Name = "Nepal", Users = "10,000+", Donors = "5,000+", Requests = "4,500+" },
                        new { Flag = "in", Name = "India", Users = "15,000+", Donors = "7,000+", Requests = "6,500+" },
                        new { Flag = "us", Name = "USA", Users = "25,000+", Donors = "12,000+", Requests = "11,000+" },
                        new { Flag = "gb", Name = "United Kingdom", Users = "20,000+", Donors = "10,000+", Requests = "9,000+" },
                        new { Flag = "ca", Name = "Canada", Users = "8,000+", Donors = "4,000+", Requests = "3,500+" },
                        new { Flag = "au", Name = "Australia", Users = "12,000+", Donors = "6,000+", Requests = "5,500+" },
                    };

                    foreach (var country in countries)
                    {
                        <tr>
                            <td class="d-flex align-items-center justify-content-center">
                                <img src="https://flagcdn.com/w40/@(country.Flag).png" alt="@country.Name Flag" class="me-2" style="width: 30px; border-radius: 4px;" />
                                @country.Name
                            </td>
                            <td>@country.Users</td>
                            <td>@country.Donors</td>
                            <td>@country.Requests</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
<script src="~/js/apicall.js"></script>
<script src="~/js/toast.js"></script>
<script src="~/js/Home.js"></script>