@{
    ViewData["Title"] = "Verify Your Email";
    Layout = "~/Views/Shared/_Layout.cshtml"; 
}

<link href="~/css/verifycode.css" rel="stylesheet" />

<div class="verify-card">
    @* <div class="verify-image" aria-label="Blood donation image"></div> *@
    <input type="hidden" id="VerificationEmail" value="@ViewBag.VerificationEmail" />
    <img class="verify-image" src="~/images/verifypage.png" aria-label="Blood donation image" />
    <div class="verify-content">
        <h2>Verify Your Code</h2>
        <p>Enter the 6-digit code sent to your email <i>@ViewBag.VerificationEmail</i> to confirm your signup.
         @*    <br /><i>Code is valid for 5 minutes.</i> *@
            </p>
        <input type="text" id="codeInput" maxlength="6" placeholder="Enter code" autocomplete="off" />
        <span id="resendCode">Resend Code</span>
        <button id="verifyBtn" disabled>Verify</button>
        <div class="message" style="color:red; display:none" id="message"></div>
    </div>
</div>

<script src="~/js/ApiCall.js"></script>


<script src="~/js/verifyemail.js?v=@JSVersions.VerifyEmail"></script>

<script src="~/js/Toast.js"></script>
