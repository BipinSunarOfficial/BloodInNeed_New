@{
    ViewData["Title"] = "Forget Password";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* <link href="~/css/verifycode.css" rel="stylesheet" /> *@
<section class="vh-100">
    <div class="container py-5 h-100">
        <div class="row d-flex justify-content-center align-items-center h-100">
            <div class="col col-xl-10">
                <div class="card" style="border-radius: 1rem;">
                    <div class="row g-0">
                        <div class="col-md-6 col-lg-5 d-none d-md-block">
                            <img src="~/images/forgetPassword.png"
                                 alt="login form" class="img-fluid" style="border-radius: 1rem 0 0 1rem;" />
                        </div>
                        <div class="col-md-6 col-lg-7 d-flex align-items-center">
                            <div class="card-body p-4 p-lg-5 text-black">

                                <div>
                                    <input type="hidden" id="currentuserEmail" class="form-control form-control-lg" autocomplete="off" />


                                    <div class="d-flex align-items-center mb-3 pb-1 divLoginImg">
                                        @* <i class="fas fa-cubes fa-2x me-3" style="color: #ff6219;"></i> *@
                                        @* <img class="loginLogo" src="~/images/logo.png" /> *@
                                    </div>

                                    <h5 class="fw-normal mb-3 pb-3" style="letter-spacing: 1px;">Reset Password</h5>

                                   
                                    <div data-mdb-input-init class="form-outline mb-4">
                                        <small id="labelUserEmail" class="text-secondary">We will send code in your email to reset your password.</small>
                                        <br />
                                        <small id="emailError" class="text-danger" style="display: none;">Invalid email format</small>
                                        <input type="email" id="userEmail" class="form-control form-control-lg" autocomplete="off" />
                                        <label class="form-label" for="userEmail">Email address</label>
                                    </div>



                                    <div class="row mb-4" id="divResetCode" style="display:none;">
                                        <div class="col">
                                            <input type="text" id="resetCode" maxlength="6" class="form-control form-control-lg" required />
                                            <label class="form-label" for="resetCode">Enter Reset Code</label>
                                            <br />
                                            <small id="resetCodeError" class="text-danger" style="display: none;">Invalid Code</small>
                                        </div>

                                    </div>




                                    <div class="row mb-4" id="divPassword" style="display:none;">
                                        <div class="col">
                                            <input type="password" id="userPassword" class="form-control form-control-lg" required />
                                            <label class="form-label" for="userPassword">Password</label>
                                            <br />
                                            <small id="userPasswordError" class="text-danger" style="display: none;">Input Strong Password</small>
                                        </div>

                                        <div class="col">
                                            <input type="password" id="userRePassword" class="form-control form-control-lg" required />
                                            <label class="form-label" for="userRePassword">Retype Password</label>
                                            <br />
                                            <small id="rePasswordError" class="text-danger" style="display: none;">Passwords do not match.</small>
                                        </div>

                                    </div>


                                    
                                    <div class="pt-1 mb-4">
                                        <button class="btn btn-outline-danger btn-lg btn-block" id="sendCodeBtn" disabled>Send Code</button>
                                        <button class="btn btn-outline-danger btn-lg btn-block" id="verifyBtn" style="display:none;">Verify</button>
                                        <button class="btn btn-outline-danger btn-lg btn-block" id="resetBtn" style="display:none;">Reset Password</button>
                                    </div>

                                   
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script src="~/js/ApiCall.js"></script>

<script src="~/js/forgetpassword.js?v=@JSVersions.ForgetPassword"></script>

<script src="~/js/Toast.js"></script>
